{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vivi Script",
  "scopeName": "source.vivi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#stdlib" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vivi",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.vivi",
          "match": "//.*$"
        },
        {
          "name": "comment.line.semicolon.vivi",
          "match": ";;.*$"
        },
        {
          "name": "comment.line.number-sign.vivi",
          "match": "#(?!(proctime|import|interop|method)\\b).*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(#method)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.vivi" },
            "2": { "name": "entity.name.function.vivi" }
          }
        },
        {
          "name": "keyword.control.directive.vivi",
          "match": "#(proctime|import|interop|method)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vivi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vivi",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.vivi",
              "match": "%[xdsc%]"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.line.vivi",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vivi",
          "match": "\\b(if|else|while|for|in|switch|default|try|catch|break|continue|return|defer|exit|as)\\b"
        },
        {
          "name": "keyword.operator.logical.word.vivi",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.declaration.vivi",
          "match": "\\b(fn|struct|enum)\\b"
        },
        {
          "name": "variable.language.self.vivi",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.vivi",
          "match": "\\b(rune|string|bool|i8|i16|i32|i64|u8|u16|u32|u64|f16|f32|f64|ext)\\b"
        },
        {
          "name": "constant.language.null.vivi",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.language.boolean.vivi",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Raw C builtins (src/builtins.c). Callable only, never usable as values.",
          "name": "support.function.builtin.vivi",
          "match": "\\b(_write|_exit|_traceback|_clock|_rand|_len|_get|_set|_trunc|_cast|_read|_open|_close|_run|_seed|_pipe|_spawn|_wait|_mmap|_munmap|_peek|_poke|_memcpy)\\b(?=\\s*\\()"
        },
        {
          "comment": "Reflection / compile-time builtins",
          "name": "support.function.builtin.vivi",
          "match": "\\b(print|panic|type_of|kind_of|type_name|fields|methods|param|return_type|has_field|has_method|has_function|has_type|has_symbol|is_type|is_exported|symbols|functions|types|constants|imports|emit|eval)\\b(?=\\s*\\()"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "comment": "_base.vivi (auto-included)",
          "name": "support.function.library.vivi",
          "match": "\\b(malloc|free|memcpy|timestamp|traceback|rand|seed|hash|cast)\\b(?=\\s*\\()"
        },
        {
          "comment": "Io",
          "name": "support.function.library.vivi",
          "match": "\\b(rgb|clear_screen|clear_line|cursor_to|cursor_hide|cursor_show|input|read_line|println|printf|eprint|eprintln|eprintf|file_exists|file_lines|file_read|file_write|file_append)\\b(?=\\s*\\()"
        },
        {
          "comment": "Sys",
          "name": "support.function.library.vivi",
          "match": "\\b(run|capture|feed|pipe|redirect)\\b(?=\\s*\\()"
        },
        {
          "comment": "Math",
          "name": "support.function.library.vivi",
          "match": "\\b(abs|min|max|clamp|lerp|sign|copysign|trunc|ceil|round|fmod|modf|sqrt|exp|log|log10|expm1|cbrt|hypot|pow|sin|cos|atan|atan2|asin|acos|sinh|cosh|tanh|acosh|deg_to_rad|rad_to_deg|gcd|lcm|factorial|gamma|erf|erfc)\\b(?=\\s*\\()"
        },
        {
          "comment": "Time",
          "name": "support.function.library.vivi",
          "match": "\\b(now|dt|dateTime|getTime|getDay|getMonth|getYear|formatDate)\\b(?=\\s*\\()"
        },
        {
          "comment": "Strings",
          "name": "support.function.library.vivi",
          "match": "\\b(index_of|is_digit|has_prefix|has_suffix|contains|substring|split|join|replace|trim|to_upper|to_lower|reverse|to_pascal_case|to_camel_case|to_snake_case)\\b(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vivi",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.vivi",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.declaration.vivi",
          "match": "(::|:=)"
        },
        {
          "name": "keyword.operator.comparison.vivi",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vivi",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.math.vivi",
          "match": "(\\+|-|\\*|/|%|\\+\\+|--|\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.slice.vivi",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.misc.vivi",
          "match": "(\\?|:|\\||~|\\.)"
        },
        {
          "name": "keyword.operator.assignment.vivi",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.vivi" }
          }
        }
      ]
    }
  }
}
